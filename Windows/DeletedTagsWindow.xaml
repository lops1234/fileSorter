<Window x:Class="FileTagger.Windows.DeletedTagsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deleted Tags" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Locally Deleted Tags" FontSize="16" FontWeight="Bold"/>
            <TextBlock TextWrapping="Wrap" Foreground="#666" Margin="0,4,0,0"
                       Text="Tags you have deleted are listed here. You can restore a tag (which also restores its file associations) or permanently clean up the list."/>
        </StackPanel>

        <!-- Tag list -->
        <ListView x:Name="DeletedTagsListView" Grid.Row="1"
                  SelectionMode="Single"
                  BorderThickness="1" BorderBrush="#CCC">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Tag Name"  Width="160" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Directory" Width="220" DisplayMemberBinding="{Binding DirectoryPath}"/>
                    <GridViewColumn Header="Deleted At" Width="140" DisplayMemberBinding="{Binding DeletedAtDisplay}"/>
                    <GridViewColumn Header="Associated Files" Width="220" DisplayMemberBinding="{Binding FileSummary}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Detail panel -->
        <Expander Grid.Row="1" VerticalAlignment="Bottom" Header="File Paths for Selected Tag"
                  Margin="0,0,0,0" IsExpanded="False"
                  x:Name="FileDetailExpander">
            <Border Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="1" MaxHeight="140" Margin="0,2,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="FilePathsList" Margin="6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Expander>

        <!-- Buttons -->
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button x:Name="RestoreButton" Content="↩ Restore Selected"
                        Click="Restore_Click" Margin="0,0,8,0" Padding="10,5"
                        ToolTip="Re-create the selected tag and restore its file associations"/>
                <Button x:Name="ShowFilesButton" Content="📄 Show Files"
                        Click="ShowFiles_Click" Margin="0,0,8,0" Padding="10,5"
                        ToolTip="Show all file paths associated with the selected deleted tag"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CleanupAllButton" Content="🗑️ Clean Up All"
                        Click="CleanupAll_Click" Margin="0,0,8,0" Padding="10,5"
                        Background="#FFF0F0" BorderBrush="#FFAAAA"
                        ToolTip="Permanently remove all deleted-tag records and their file snapshots from the local database"/>
                <Button Content="Close" Click="Close_Click" Padding="10,5"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
