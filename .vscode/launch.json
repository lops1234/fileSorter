{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug FileTagger (WPF)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/bin/Debug/net8.0-windows/FileTagger.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false,
            "justMyCode": false,
            "requireExactSource": false,
            "symbolOptions": {
                "searchPaths": [
                    "${workspaceFolder}/bin/Debug/net8.0-windows"
                ],
                "searchMicrosoftSymbolServer": false
            },
            "logging": {
                "moduleLoad": false,
                "engineLogging": false
            }
        },
        {
            "name": "Attach to running FileTagger",
            "type": "coreclr",
            "request": "attach",
            "processName": "FileTagger"
        }
    ]
}